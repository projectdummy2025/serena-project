# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Allowed Telegram User ID for security (Only this user can send commands)
ALLOWED_USER_ID=123456789

# Agent Projects Workspace (Lokasi Seluruh Proyek & Kode Buatan Serena)
SERENA_PROJECTS_DIR=~/serena-projects


# Obsidian Vault Directory
OBSIDIAN_VAULT_DIR=~/obsidian_vault

# OpenAI Compatible API Configuration (Orchestrator AI)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

